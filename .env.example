POSTGRES_USER=den
POSTGRES_PASSWORD=changeme
POSTGRES_DB=den
POSTGRES_PORT=5440

APP_PORT=8080

# Supabase Auth (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Voice (WebRTC SFU)
STUN_SERVERS=stun:stun.l.google.com:19302
# Optional TURN server for NAT traversal
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Bucket Storage (S3-compatible, e.g. Cloudflare R2)
# Omit or leave empty to disable emote uploads
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_REGION=auto
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_PUBLIC_URL=
