POSTGRES_USER=den
POSTGRES_PASSWORD=changeme
POSTGRES_DB=den
# POSTGRES_PORT=5440

# APP_PORT=8080

# Authentication (required)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# SMTP (optional — enables email verification and password reset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# Frontend URL for email links (optional, default: http://localhost:5173)
# FRONTEND_URL=https://your-domain.com

# App settings
# MAX_MESSAGES=50
# OPEN_REGISTRATION=true

# Voice (WebRTC SFU)
# PUBLIC_IP=          # Server's public IP — required for voice to work across networks
# UDP_PORT_RANGE=20000-21000  # UDP port range for WebRTC media (must match firewall/Docker)
# STUN_SERVERS=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Bucket Storage (S3-compatible, e.g. Cloudflare R2)
# Omit or leave empty to disable file uploads
# BUCKET_ENDPOINT=
# BUCKET_NAME=
# BUCKET_REGION=auto
# BUCKET_ACCESS_KEY=
# BUCKET_SECRET_KEY=
# BUCKET_PUBLIC_URL=

# CORS (optional — comma-separated allowed origins for WebSocket)
# ALLOWED_ORIGINS=https://your-domain.com
